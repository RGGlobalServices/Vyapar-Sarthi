generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  // Runtime queries go through the transaction-mode pooler (port 6543), which
  // releases the connection after each statement. Session mode (5432) holds a
  // backend per client and exhausts the instance's connection slots.
  url          = env("DATABASE_URL")
  // Migrations need a real session, so they use the direct 5432 connection.
  directUrl    = env("DIRECT_URL")
  relationMode = "foreignKeys"
}

model User {
  id                  Int           @id @default(autoincrement())
  uuid                String?       @unique @db.Uuid
  email               String        @unique @db.VarChar
  name                String        @default("") @db.VarChar
  mobile              String?       @db.VarChar
  password            String        @db.VarChar
  storeName           String?       @map("store_name") @db.VarChar
  businessType        String?       @map("business_type") @db.VarChar
  createdAt           DateTime?     @default(now()) @map("created_at") @db.Timestamptz(6)
  fullName            String?       @map("full_name") @db.VarChar
  isActive            Int?          @default(1) @map("is_active")
  passwordResetToken  String?       @map("password_reset_token") @db.VarChar
  passwordResetExpiry DateTime?     @map("password_reset_expiry") @db.Timestamptz(6)
  profitViewPassword  String?       @map("profit_view_password") @db.VarChar
  adminPin            String?       @map("admin_pin") @db.VarChar
  maxShops            Int?          @map("max_shops")
  canAddShop          Boolean?      @default(true) @map("can_add_shop")
  allShopAccess       Boolean?      @default(false) @map("all_shop_access")
  selectedShopIds     String[]      @default([]) @map("selected_shop_ids")
  toolUsages          ToolUsage[]
  sessions            UserSession[]

  @@map("users")
}

model ToolUsage {
  id       String   @id @default(uuid()) @db.Uuid
  userId   Int      @map("user_id")
  tool     String   @db.VarChar
  count    Int      @default(1)
  lastUsed DateTime @default(now()) @map("last_used") @db.Timestamptz(6)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([userId, tool])
  @@map("tool_usage")
}

model UserSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    Int      @map("user_id")
  device    String   @db.VarChar
  os        String   @db.VarChar
  browser   String   @db.VarChar
  ip        String   @db.VarChar
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeen  DateTime @default(now()) @map("last_seen") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model Shop {
  id                      String               @id @default(uuid()) @db.Uuid
  ownerId                 String?              @map("owner_id") @db.Uuid
  name                    String?              @db.VarChar
  address                 String?              @db.VarChar
  createdAt               DateTime?            @default(now()) @map("created_at") @db.Timestamptz(6)
  businessType            String?              @default("kirana") @map("business_type") @db.VarChar
  // Sub-type for compound business types — used today by the unified
  // "Mills & Grain Processing" (businessType='millprocessing') to record
  // WHICH kind of mill this shop actually runs (ricemill / dalmill / bhagarmill
  // / flourmill / oilmill / …). Kept generic so other future compound types
  // can reuse the same column without a fresh migration.
  businessSubtype         String?              @map("business_subtype") @db.VarChar
  // Products / raw materials this shop processes — e.g. ["Rice","Wheat","Jowar"]
  // for a mill that does multiple grains. Multi-select so a single shop that
  // handles Rice + Dal + Flour doesn't need three business accounts.
  businessProducts        String[]             @default([]) @map("business_products")
  setupComplete           Boolean?             @default(false) @map("setup_complete")
  mobile                  String?
  logoUrl                 String?              @map("logo_url")
  // Scanned/photographed owner signature or shop stamp, shown above
  // "Authorized Signatory" on printed/PDF bills (A4 + thermal). Same
  // upload-to-storage pattern as logoUrl.
  signatureUrl            String?              @map("signature_url")
  shopCode                String?              @unique @map("shop_code") @db.VarChar
  packageType             String?              @default("dukan") @map("package_type") @db.VarChar
  subscriptionPlan        String?              @default("trial") @map("subscription_plan") @db.VarChar
  subscriptionStatus      String?              @default("active") @map("subscription_status") @db.VarChar
  subscriptionExpiry      DateTime?            @map("subscription_expiry") @db.Timestamptz(6)
  subscriptionCancelledAt DateTime?            @map("subscription_cancelled_at") @db.Timestamptz(6)
  cancellationReason      String?              @map("cancellation_reason")
  // Free trial + auto-debit (PayU Standing Instruction / eMandate)
  subscriptionTrialEnds   DateTime?            @map("subscription_trial_ends") @db.Timestamptz(6)
  trialPaused             Boolean?             @default(false) @map("trial_paused")
  trialPauseStart         DateTime?            @map("trial_pause_start") @db.Timestamptz(6)
  mandateToken            String?              @map("mandate_token") @db.VarChar
  mandateStatus           String?              @map("mandate_status") @db.VarChar
  nextBillingDate         DateTime?            @map("next_billing_date") @db.Timestamptz(6)
  billingAmount           Float?               @map("billing_amount")
  billingCycle            String?              @default("monthly") @map("billing_cycle") @db.VarChar
  lastTxnId               String?              @map("last_txn_id") @db.VarChar
  firstChargeDate         DateTime?            @map("first_charge_date") @db.Timestamptz(6)
  gst                     String?              @db.VarChar
  pan                     String?              @db.VarChar
  invoiceFormat           String?              @default("thermal80") @map("invoice_format") @db.VarChar
  // Visual design of the printed/PDF bill — 'standard' (current plain black
  // layout), 'modern' (colored header band), 'stylish' (bold accent-colored
  // side panel), 'advanced_gst' (standard + prominent HSN/SAC summary table).
  // Independent of invoiceFormat, which picks the paper size (thermal/A4).
  invoiceTheme            String?              @default("standard") @map("invoice_theme") @db.VarChar
  // Accent hex color for the invoice theme's header/borders/highlights —
  // '' or null means no color (the original plain black-on-white look).
  invoiceColor            String?              @map("invoice_color") @db.VarChar
  invoiceFooter           String?              @map("invoice_footer")
  showQrCode              Boolean?             @default(false) @map("show_qr_code")
  // When true, the product-catalog profit preview (Add/Edit modal, product
  // list, product detail) strips GST out of the selling price before
  // comparing to cost — i.e. profit = (sellingPrice / (1 + gst/100)) - cost.
  // Default false: profit = sellingPrice - cost, matching plain shopkeeper
  // markup intuition. Independent of the tax-liability-aware profit used at
  // billing time (lib/financialEngine.ts), which always nets out GST.
  gstInclusiveProfit      Boolean?             @default(false) @map("gst_inclusive_profit")
  // Which page opens first after login/app-load — a route segment like
  // 'billing' or 'stock', matching the Sidebar's module keys. Null/empty
  // means the normal default (Dashboard) — set from Settings.
  defaultLandingPage      String?              @map("default_landing_page") @db.VarChar
  // Shown on printed/PDF bills (GST and Non-GST, every package tier) as a
  // scan-to-pay UPI QR + bank transfer details — set once in Profile, then
  // reused on every invoice without re-entering it per bill.
  upiId                   String?              @map("upi_id") @db.VarChar
  bankName                String?              @map("bank_name") @db.VarChar
  bankAccountName         String?              @map("bank_account_name") @db.VarChar
  bankAccountNumber       String?              @map("bank_account_number") @db.VarChar
  bankIfsc                String?              @map("bank_ifsc") @db.VarChar
  // Which IndustryCategory (Kirana/Garment/Pharmacy/…) this shop picked via
  // Profile's "Change Business Category" wizard. Plain scalar, not a Prisma
  // relation — IndustryCategory is looked up separately by id where needed,
  // to avoid growing this already-large model's relation list. Purely
  // additive: never read by the businessType/packageType engine below.
  industryCategoryId      String?              @map("industry_category_id") @db.Uuid

  customers               Customer[]
  products                Product[]
  sales                   Sale[]
  stockLogs               StockLog[]
  dailyStockEntries       DailyStockEntry[]
  dailyRegisterLogs       DailyRegisterLog[]
  godowns                 Godown[]
  paymentTransactions     PaymentTransaction[]
  materialReturns         MaterialReturn[]
  staff                   Staff[]
  suppliers               Supplier[]
  purchaseInvoices        PurchaseInvoice[]
  purchaseReturns         PurchaseReturn[]
  batches                 Batch[]
  expenses                Expense[]
  orders                  Order[]
  deliveryChallans        DeliveryChallan[]
  stockTakeSessions       StockTakeSession[]
  categories              Category[]
  brands                  Brand[]
  units                   Unit[]
  expenseCategories       ExpenseCategory[]
  cashBooks               CashBook[]
  dailyClosings           DailyClosing[]
  activityLogs            ActivityLog[]
  importLogs              ImportLog[]
  rawMaterialLots         RawMaterialLot[]
  productionBatches       ProductionBatch[]
  byProducts              ByProduct[]
  qualityTests            QualityTest[]
  gateEntries             GateEntry[]
  weighbridgeEntries      WeighbridgeEntry[]
  freightEntries          FreightEntry[]
  dispatchEntries         DispatchEntry[]
  commissionEntries       CommissionEntry[]
  machines                Machine[]
  maintenanceEntries      MaintenanceEntry[]
  machineDowntimes        MachineDowntime[]
  spareParts              SparePart[]
  sparePartMovements      SparePartMovement[]
  deletedRecords          DeletedRecord[]
  collectionSheets        CollectionSheet[]

  @@index([name], map: "ix_shops_name")
  @@index([ownerId], map: "ix_shops_owner_id")
  @@map("shops")
}

// Recovery bin — a snapshot taken right before a real (destructive) delete
// happens on a supported entity, so a shopkeeper (or admin, for the internal
// ops tool) can browse/restore/download it later, within a 30-day window
// enforced by the purge cron (see app/api/v1/cron/purge-trash). Deliberately
// separate from the entities' own tables rather than a deletedAt-on-every-table
// soft-delete: existing list/search queries across the app never need to
// change, since a deleted row genuinely leaves its original table until
// restored. Customers are a special case — their own delete route already
// soft-deletes via an `archived_` customerType prefix (never destroys the
// row), so restoring one un-prefixes it instead of re-inserting from `data`.
// entityType is a free-text discriminator (see TrashEntityType in
// lib/server/trash.ts): 'product' | 'customer' | 'customer_transaction' |
// 'supplier' | 'staff' | 'sale'.
model DeletedRecord {
  id         String    @id @default(uuid()) @db.Uuid
  shopId     String    @map("shop_id") @db.Uuid
  // 'product' | 'customer' | 'supplier' | 'staff'
  entityType String    @map("entity_type") @db.VarChar
  entityId   String    @map("entity_id") @db.VarChar
  label      String?   @db.VarChar
  data       Json
  deletedBy  String?   @map("deleted_by") @db.VarChar
  deletedAt  DateTime  @default(now()) @map("deleted_at") @db.Timestamptz(6)
  restoredAt DateTime? @map("restored_at") @db.Timestamptz(6)
  // Set the first time the purge cron warns the shop owner this record is
  // about to be permanently deleted — purge only ever acts on rows where
  // this is already set, so a row can never be purged without a prior warning.
  purgeWarnedAt DateTime? @map("purge_warned_at") @db.Timestamptz(6)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([entityType])
  @@index([deletedAt])
  @@index([purgeWarnedAt])
  @@index([restoredAt, deletedAt])
  @@map("deleted_records")
}

model Expense {
  id          String   @id @default(uuid()) @db.Uuid
  shopId      String   @map("shop_id") @db.Uuid
  category    String   @db.VarChar
  amount      Float
  date        DateTime @default(now()) @db.Timestamptz(6)
  description String?  @db.VarChar
  paymentMode   String?  @map("payment_mode") @db.VarChar
  attachmentUrl String?  @map("attachment_url") @db.VarChar
  isRecurring   Boolean? @default(false) @map("is_recurring")
  warehouseId   String?  @map("warehouse_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([shopId, date(sort: Desc)], map: "ix_expenses_shop_date")
  @@index([shopId, category], map: "ix_expenses_shop_category")
  @@map("expenses")
}

model Order {
  id          String   @id @default(uuid()) @db.Uuid
  shopId      String   @map("shop_id") @db.Uuid
  orderNumber String   @map("order_number") @db.VarChar
  customerId  String?  @map("customer_id") @db.Uuid
  totalAmount Float    @map("total_amount")
  status      String   @default("pending") @db.VarChar
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // 'incoming' = a party/customer ordered from us; 'outgoing' = we ordered
  // from a supplier. customerId is used for incoming, supplierId for
  // outgoing — an explicit field instead of inferring from which FK is set,
  // since neither is required and inference would be ambiguous when empty.
  direction    String    @default("incoming") @db.VarChar
  supplierId   String?   @map("supplier_id") @db.Uuid
  // Scheduled/expected completion date — separate from completedAt (the
  // real timestamp, set once status actually becomes "completed") so a
  // missed schedule stays visible instead of being overwritten.
  expectedDate DateTime? @map("expected_date") @db.Timestamptz(6)
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(6)
  notes        String?   @db.VarChar

  shop     Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer Customer?   @relation(fields: [customerId], references: [id], onDelete: NoAction)
  supplier Supplier?   @relation(fields: [supplierId], references: [id], onDelete: NoAction)
  items    OrderItem[]
  deliveryChallans DeliveryChallan[]

  @@index([shopId])
  @@index([customerId])
  @@index([supplierId])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @map("order_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  // Composite "Colour / Size" (or bare size) key into Product.variants[] JSON —
  // same convention as PurchaseItem.variantKey. Null for a non-variant line.
  variantKey String? @map("variant_key") @db.VarChar
  quantity  Float
  price     Float

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// A dispatch/delivery note — goods physically leave the shop against this
// document (stock is decremented the moment it's created, mirroring a real
// paper challan handed to the driver) BEFORE the formal GST invoice is
// raised. Optionally linked to a Sales Order (partial fulfillment — one
// order can spawn several challans over time) and later "converted" into a
// real Sale via the normal billing flow, which is what actually books the
// revenue/GST/party ledger — this model only tracks the physical movement +
// prints the delivery note, deliberately kept OUT of anything financial so
// it never risks double-counting revenue or drifting from billing/route.ts's
// carefully-tuned sale-creation logic.
model DeliveryChallan {
  id            String    @id @default(uuid()) @db.Uuid
  shopId        String    @map("shop_id") @db.Uuid
  challanNumber String    @map("challan_number") @db.VarChar
  orderId       String?   @map("order_id") @db.Uuid
  customerId    String?   @map("customer_id") @db.Uuid
  customerName  String?   @map("customer_name") @db.VarChar
  customerMobile String?  @map("customer_mobile") @db.VarChar
  customerAddress String? @map("customer_address")
  // 'open' = dispatched, not yet invoiced; 'invoiced' = converted to a real
  // Sale (see saleId); 'cancelled' = stock was restored, void document.
  status        String    @default("open") @db.VarChar
  saleId        String?   @map("sale_id") @db.Uuid
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  invoicedAt    DateTime? @map("invoiced_at") @db.Timestamptz(6)

  shop     Shop                  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  order    Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customer Customer?             @relation(fields: [customerId], references: [id], onDelete: NoAction)
  items    DeliveryChallanItem[]

  @@index([shopId])
  @@index([customerId])
  @@index([orderId])
  @@map("delivery_challans")
}

model DeliveryChallanItem {
  id         String  @id @default(uuid()) @db.Uuid
  challanId  String  @map("challan_id") @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  // Snapshot at dispatch time — a later product rename/price edit must not
  // change what a printed challan says it sent, same reasoning as
  // PurchaseItem/OrderItem's own snapshots.
  name       String  @db.VarChar
  unit       String  @db.VarChar
  variantKey String? @map("variant_key") @db.VarChar
  quantity   Float
  price      Float

  challan DeliveryChallan @relation(fields: [challanId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([challanId])
  @@index([productId])
  @@map("delivery_challan_items")
}

model PaymentTransaction {
  id           String   @id @default(uuid()) @db.Uuid
  shopId       String   @map("shop_id") @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  txnid        String   @db.VarChar
  mihpayid     String?  @db.VarChar
  plan         String?  @db.VarChar
  amount       Float
  billingCycle String?  @map("billing_cycle") @db.VarChar
  baseAmount   Float?   @map("base_amount")
  gstAmount    Float?   @map("gst_amount")
  // mandate_registration | recurring | trial | refund
  type         String   @db.VarChar
  // success | failed | pending | refunded
  status       String   @db.VarChar
  mode         String?  @db.VarChar
  payuResponse String?  @map("payu_response") @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([txnid])
  @@map("payment_transactions")
}

model Product {
  id               String           @id @default(uuid()) @db.Uuid
  shopId           String?          @map("shop_id") @db.Uuid
  name             String?          @db.VarChar
  category         String?          @db.VarChar
  baseUnit         String?          @map("base_unit") @db.VarChar
  mrp              Float?
  sellingPrice     Float?           @map("selling_price")
  // Udyog only: wholesaleCost is the price CHARGED when billing in Wholesale
  // mode (to other shopkeepers/dealers) — despite the name, it is a selling
  // price, not a cost basis. costPrice below is the actual amount paid to
  // the vendor, used for margin/profitability, and is separate on purpose —
  // conflating the two previously made profit calculations read the
  // wholesale selling price as if it were COGS.
  wholesaleCost    Float?           @map("wholesale_cost")
  costPrice        Float?           @map("cost_price")
  // 'manual' (default, today's behavior — costPrice typed directly) or
  // 'mrp_based' (costPrice is derived as mrp * (1 - purchaseDiscountPercent/100)
  // and recomputed live in Add/Edit Product; still written into costPrice on
  // save so every existing consumer of that field needs no changes).
  costPriceMode    String?          @default("manual") @map("cost_price_mode")
  purchaseDiscountPercent Float?    @map("purchase_discount_percent")
  conversionFactor Float?           @map("conversion_factor")
  minStock         Float?           @map("min_stock")
  currentStock     Float?           @map("current_stock")
  // Uniqueness is per shop (see @@unique below), NOT global. Real EAN/UPC codes
  // are shared by every shop that stocks the product, so a global constraint
  // meant the second shop to add an item hit a unique violation.
  // "Company Barcode" in the UI — the EAN/UPC printed on the item.
  barcode          String?          @db.VarChar
  // Shop's own stock-keeping code, and the barcode printed on an outer carton.
  // Both are alternative keys the billing scanner can resolve a product by.
  sku              String?          @db.VarChar
  // Free-text code the shopkeeper writes once against a product — no
  // scan/lookup meaning like barcode/sku, purely a printable reference
  // (e.g. a supplier's own item code) so it doesn't need retyping every
  // time a barcode label is printed. Surfaced as a text-field toggle in
  // Barcode Print Settings.
  otherCode        String?          @map("other_code") @db.VarChar
  cartonBarcode    String?          @map("carton_barcode") @db.VarChar
  // Free-text shelf/rack/bin locator — distinct from the Godown model (a
  // whole warehouse, Udyog-only); this is available to every business tier.
  location         String?          @db.VarChar
  expiryDate       String?          @map("expiry_date") @db.VarChar
  batch_number     String?          @db.VarChar
  drug_schedule    String?          @db.VarChar
  model_number     String?          @db.VarChar
  warranty_months  Int?
  gender           String?          @db.VarChar
  size_variants    String?
  shade            String?          @db.VarChar
  archived         Boolean?         @default(false)
  is_loose         Boolean?         @default(false)
  metadata         Json?            @default("{}")
  variants         Json?            @default("[]")
  brand            String?          @db.VarChar
  hsnCode          String?          @map("hsn_code") @db.VarChar
  productType      String?          @default("single") @map("product_type") @db.VarChar
  // Bada Udyog / Mills only — classifies a product on the mill workflow:
  // 'raw_material' (Paddy, Wheat, Bajra…) / 'finished_goods' (Rice, Flour,
  // Oil…) / 'by_product' (Bran, Husk, Chuni…) / 'waste'. Null for every
  // non-mill shop; existing millprocessing shops can classify their catalogue
  // gradually — no default forces a category on unsorted items.
  millCategory     String?          @map("mill_category") @db.VarChar
  // Bag / pack size for weight-based selling (30 = 30 Kg per bag). Powers
  // the Bag × BagSize = Total Weight auto-calc used by Sales & Purchase
  // billing in the mill workflow. Independent of baseUnit above — the base
  // unit stays Kg / Ltr / Piece; packSize is *how many baseUnits per bag*.
  packSize         Float?           @map("pack_size")
  // Unit of packSize itself — usually 'Kg' but a mill that packs oil sells
  // 15 Litre tins ('15' + 'Ltr') or a papad unit sells 250-gram packets
  // ('250' + 'GM'). Stored separately so the label reads "30 Kg Bag" not
  // just "30" and the multiplier is unambiguous during billing.
  packUnit         String?          @map("pack_unit") @db.VarChar
  // Generic Food-Mill Product Master fields — free text on purpose (same
  // pattern as brand/shade below), so any mill type can type its own values
  // instead of picking from a hard-coded list. Kept separate from `category`
  // (Rice/Wheat/Dal/…) since Grade+Variety describe a QUALITY tier within a
  // category (Category=Rice, Grade=Premium, Variety=Basmati), not the item
  // itself.
  grade            String?          @db.VarChar
  variety          String?          @db.VarChar
  subcategory      String?          @db.VarChar
  // Distinct from minStock: minStock is "don't let stock go below this"
  // (existing field, used across every business type); reorderLevel is
  // "tell me to reorder at this level" — a mill often wants a heads-up
  // buffer above the hard minimum. Null falls back to minStock in status
  // calculations, so shops that never set it keep today's exact behavior.
  reorderLevel     Float?           @map("reorder_level")
  // Per-product override of the shop-wide bizConfig.hasBatch/hasExpiry
  // flags — null means "inherit the shop's default" (today's behavior,
  // unchanged for every existing product/business type). Only meaningfully
  // settable where the shop-wide flag is already true; lets one mill batch-
  // track its Rice but skip it for a Packaging Material line, without
  // affecting any other business type's Add/Edit form.
  trackBatch       Boolean?         @map("track_batch")
  trackExpiry      Boolean?         @map("track_expiry")
  gstPercent       Float?           @map("gst_percent")
  // When the product was first added. Backfilled for pre-existing rows from the
  // earliest stock activity, so it reflects real history, not the migration date.
  createdAt        DateTime?        @default(now()) @map("created_at") @db.Timestamptz(6)
  shop             Shop?            @relation(fields: [shopId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  saleItems        SaleItem[]
  stock_logs       StockLog[]
  godownProducts   GodownProduct[]
  materialReturns  MaterialReturn[]
  returnItems      ReturnItem[]
  productVariants  ProductVariant[]
  batches          Batch[]
  purchaseItems    PurchaseItem[]
  purchaseReturnItems PurchaseReturnItem[]
  orderItems       OrderItem[]
  deliveryChallanItems DeliveryChallanItem[]
  stockTakeItems   StockTakeItem[]
  dailyStockEntries DailyStockEntry[]
  dailyRegisterLogs DailyRegisterLog[]

