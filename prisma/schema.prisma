// One row per individual Receive/Close edit made on a Daily Register entry —
// an audit trail of exactly when each update happened, distinct from
// DailyStockEntry which only holds the latest saved values for the day.
model DailyRegisterLog {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  date      DateTime @db.Date
  type      String   @db.VarChar
  quantity  Float
  note      String?  @db.VarChar
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  shop    Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([shopId, productId, date], map: "ix_daily_register_logs_shop_product_date")
  @@map("daily_register_logs")
}

model ActivityLog {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String   @db.VarChar // e.g. "expense_added", "staff_added", "daily_closed"
  entityId  String?  @map("entity_id") @db.Uuid
  details   Json?    @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt(sort: Desc)])
  @@map("activity_logs")
}

// ─── Import Log ──────────────────────────────────────────────────────────────
// Tracks every AI-import session: who, when, how many rows succeeded/failed.

model ImportLog {
  id            String    @id @default(uuid()) @db.Uuid
  shopId        String    @map("shop_id") @db.Uuid
  importName    String    @map("import_name") @db.VarChar
  fileName      String?   @map("file_name") @db.VarChar
  source        String    @db.VarChar // 'stock' | 'purchase' | 'mixed'
  totalRows     Int       @map("total_rows")
  importedCount Int       @default(0) @map("imported_count")
  updatedCount  Int       @default(0) @map("updated_count")
  skippedCount  Int       @default(0) @map("skipped_count")
  failedCount   Int       @default(0) @map("failed_count")
  errors        Json?     @default("[]")
  processingMs  Int?      @map("processing_ms")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt(sort: Desc)])
  @@map("import_logs")
}

// ─── Rice Mill / Bhagar Mill — Phase 2 schema ──────────────────────────────
// A mill buys raw grain from farmers in lots (weight, moisture %, rate, lot#),
// then runs one or more production batches that consume a lot and produce
// finished rice + by-products (bran, husk, chuni…). These four models capture
// that pipeline; the Phase 3 UI drives stage transitions and the Phase 4
// costing engine reads from ProductionBatch + BatchStage to derive per-kg cost.

model RawMaterialLot {
  id            String    @id @default(uuid()) @db.Uuid
  shopId        String    @map("shop_id") @db.Uuid
  productId     String?   @map("product_id") @db.Uuid    // links to the raw-material Product row (Paddy, Wheat, …)
  supplierId    String?   @map("supplier_id") @db.Uuid   // Supplier row for the farmer / vendor
  lotNumber     String?   @map("lot_number") @db.VarChar
  farmerName    String?   @map("farmer_name") @db.VarChar
  purchaseDate  DateTime  @default(now()) @map("purchase_date") @db.Timestamptz(6)
  weightKg      Float?    @map("weight_kg")
  moisturePct   Float?    @map("moisture_pct")
  ratePerKg     Float?    @map("rate_per_kg")
  totalAmount   Float?    @map("total_amount")
  remainingKg   Float?    @map("remaining_kg")           // decremented as batches consume this lot
  notes         String?   @db.VarChar
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  shop       Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product    Product?           @relation(fields: [productId], references: [id], onDelete: NoAction)
  supplier   Supplier?          @relation(fields: [supplierId], references: [id], onDelete: NoAction)
  batches    ProductionBatch[]
  weighbridgeEntries WeighbridgeEntry[]
  qualityTests QualityTest[]

  @@index([shopId])
  @@index([supplierId])
  @@index([productId])
  @@map("raw_material_lots")
}

model ProductionBatch {
  id             String    @id @default(uuid()) @db.Uuid
  shopId         String    @map("shop_id") @db.Uuid
  batchNumber    String    @map("batch_number") @db.VarChar
  rawLotId       String?   @map("raw_lot_id") @db.Uuid   // source lot; null if consumed multiple
  // The finished-good Product this batch produces (e.g. "Rice" from a
  // "Paddy" raw lot). Optional so existing batches created before this field
  // keep working unchanged — closing a batch only credits Product stock when
  // this is set.
  outputProductId String? @map("output_product_id") @db.Uuid
  // The target output set when the batch is started (e.g. "expect ~650 Kg
  // rice from 1000 Kg paddy at 65% recovery") — what turns this from a bare
  // activity log into a real planned-vs-actual production order. Null for
  // batches that don't bother planning ahead; outputKg (actual) is always
  // what matters for stock/profit, this is purely a variance comparison.
  plannedOutputKg Float?   @map("planned_output_kg")
  inputKg        Float?    @map("input_kg")
  outputKg       Float?    @map("output_kg")             // final finished-good weight
  wastageKg      Float?    @map("wastage_kg")
  brokenKg       Float?    @map("broken_kg")             // broken rice
  branKg         Float?    @map("bran_kg")
  huskKg         Float?    @map("husk_kg")
  recoveryPct    Float?    @map("recovery_pct")          // outputKg / inputKg × 100
  status         String    @default("open") @db.VarChar  // open | in_progress | closed
  currentStage   String    @default("cleaning") @map("current_stage") @db.VarChar
  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  closedAt       DateTime? @map("closed_at") @db.Timestamptz(6)
  notes          String?   @db.VarChar
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  shop         Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  rawLot       RawMaterialLot? @relation(fields: [rawLotId], references: [id], onDelete: NoAction)
  outputProduct Product?       @relation("ProductionBatchOutput", fields: [outputProductId], references: [id], onDelete: NoAction)
  stages       BatchStage[]
  byProducts   ByProduct[]
  qualityTests QualityTest[]

  @@unique([shopId, batchNumber])
  @@index([shopId])
  @@index([rawLotId])
  @@index([status])
  @@map("production_batches")
}

model BatchStage {
  id           String    @id @default(uuid()) @db.Uuid
  batchId      String    @map("batch_id") @db.Uuid
  stageName    String    @map("stage_name") @db.VarChar  // cleaning | drying | shelling | polishing | packing
  sequence     Int       @default(0)                     // 1..N — display order + progress calc
  inputKg      Float?    @map("input_kg")
  outputKg     Float?    @map("output_kg")
  wastageKg    Float?    @map("wastage_kg")
  startedAt    DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(6)
  operatorName String?   @map("operator_name") @db.VarChar
  notes        String?   @db.VarChar
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  batch ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@map("batch_stages")
}

model ByProduct {
  id           String    @id @default(uuid()) @db.Uuid
  shopId       String    @map("shop_id") @db.Uuid
  batchId      String?   @map("batch_id") @db.Uuid       // originating batch; null for manual additions
  // Optional link to a real sellable Product row — when set, recording this
  // by-product credits that product's stock, same as a finished-good batch
  // output. Left null for a by-product the shop doesn't track as inventory.
  productId    String?   @map("product_id") @db.Uuid
  name         String    @db.VarChar                     // Bran | Husk | Chuni | Polish | Dust | Broken Rice
  quantityKg   Float?    @map("quantity_kg")
  soldKg       Float?    @default(0) @map("sold_kg")
  ratePerKg    Float?    @map("rate_per_kg")
  notes        String?   @db.VarChar
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  shop    Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  batch   ProductionBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  product Product?         @relation(fields: [productId], references: [id], onDelete: NoAction)

  @@index([shopId])
  @@index([batchId])
  @@map("by_products")
}

// A lab reading against either an incoming raw-material lot (accept/reject
// the farmer's delivery before it enters production) or a finished
// production batch (certify the output before it's sold/dispatched) — never
// both. moisture/foreignMatter/broken/damaged/doc % mirror the standard
// grain-grading fields a mill buyer actually checks. `flag` is a computed
// green/amber/red snapshot at save time (see QUALITY_FLAG_THRESHOLDS in
// lib/businessConfig.ts) so a later threshold change doesn't rewrite
// history; `decision` is the shopkeeper's own accept/reject call, which can
// disagree with the flag (e.g. accept an amber lot at a lower rate).
model QualityTest {
  id               String    @id @default(uuid()) @db.Uuid
  shopId           String    @map("shop_id") @db.Uuid
  rawLotId         String?   @map("raw_lot_id") @db.Uuid
  batchId          String?   @map("batch_id") @db.Uuid
  testDate         DateTime  @default(now()) @map("test_date") @db.Timestamptz(6)
  testedBy         String?   @map("tested_by") @db.VarChar
  moisturePct      Float?    @map("moisture_pct")
  foreignMatterPct Float?    @map("foreign_matter_pct")
  brokenPct        Float?    @map("broken_pct")
  damagedPct       Float?    @map("damaged_pct")
  docPct           Float?    @map("doc_pct")          // protein / oil content, grain-dependent
  flag             String?   @db.VarChar              // green | amber | red
  decision         String    @default("pending") @db.VarChar // pending | accepted | rejected
  certificateUrl   String?   @map("certificate_url") @db.VarChar
  notes            String?   @db.VarChar
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  shop   Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  rawLot RawMaterialLot?  @relation(fields: [rawLotId], references: [id], onDelete: SetNull)
  batch  ProductionBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([shopId])
  @@index([rawLotId])
  @@index([batchId])
  @@map("quality_tests")
}

// ─── Gate Entry + Weighbridge ────────────────────────────────────────────
// The real mill-floor flow feeding RawMaterialLot above: a truck arrives
// (GateEntry) → weighed loaded, unloaded, then weighed empty for the net
// weight (WeighbridgeEntry, two-weigh workflow) → once weighing is done the
// net weight becomes a RawMaterialLot (via /mill/weighbridge/[id]/convert-to-lot),
// which then feeds a ProductionBatch exactly like a manually-entered lot does.

model GateEntry {
  id                  String    @id @default(uuid()) @db.Uuid
  shopId              String    @map("shop_id") @db.Uuid
  entryNumber         String    @map("entry_number") @db.VarChar
  direction           String    @default("inward") @db.VarChar // inward | outward
  vehicleNumber       String    @map("vehicle_number") @db.VarChar
  driverName          String?   @map("driver_name") @db.VarChar
  driverMobile        String?   @map("driver_mobile") @db.VarChar
  supplierId          String?   @map("supplier_id") @db.Uuid
  // Destination Customer/Party for an outward (dispatch) trip — mirrors
  // supplierId's role for inward trips, just the other direction. Nullable
  // since not every outward trip has (or needs) a registered party.
  partyId             String?   @map("party_id") @db.Uuid
  materialDescription String?   @map("material_description") @db.VarChar
  status              String    @default("at_gate") @db.VarChar // at_gate | weighed | exited
  enteredAt           DateTime  @default(now()) @map("entered_at") @db.Timestamptz(6)
  exitedAt            DateTime? @map("exited_at") @db.Timestamptz(6)
  notes               String?   @db.VarChar
  createdAt           DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  shop               Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  supplier           Supplier?          @relation(fields: [supplierId], references: [id], onDelete: NoAction)
  party              Customer?          @relation("GateEntryParty", fields: [partyId], references: [id], onDelete: NoAction)
  weighbridgeEntries WeighbridgeEntry[]
  freightEntries     FreightEntry[]
  dispatchEntries    DispatchEntry[]

  @@unique([shopId, entryNumber])
  @@index([shopId])
  @@index([status])
  @@map("gate_entries")
}

model WeighbridgeEntry {
  id                  String    @id @default(uuid()) @db.Uuid
  shopId              String    @map("shop_id") @db.Uuid
  slipNumber          String    @map("slip_number") @db.VarChar
  gateEntryId         String?   @map("gate_entry_id") @db.Uuid
  vehicleNumber       String    @map("vehicle_number") @db.VarChar
  materialDescription String?   @map("material_description") @db.VarChar
  productId           String?   @map("product_id") @db.Uuid
  supplierId          String?   @map("supplier_id") @db.Uuid
  grossWeightKg       Float?    @map("gross_weight_kg")
  tareWeightKg        Float?    @map("tare_weight_kg")
  netWeightKg         Float?    @map("net_weight_kg")
  moisturePct         Float?    @map("moisture_pct")
  ratePerKg           Float?    @map("rate_per_kg")
  firstWeighedAt      DateTime? @map("first_weighed_at") @db.Timestamptz(6)
  secondWeighedAt     DateTime? @map("second_weighed_at") @db.Timestamptz(6)
  status              String    @default("first_weighed") @db.VarChar // first_weighed | completed | converted
  rawLotId            String?   @map("raw_lot_id") @db.Uuid
  notes               String?   @db.VarChar
  createdAt           DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  shop      Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  gateEntry GateEntry?      @relation(fields: [gateEntryId], references: [id], onDelete: SetNull)
  product   Product?        @relation(fields: [productId], references: [id], onDelete: NoAction)
  supplier  Supplier?       @relation(fields: [supplierId], references: [id], onDelete: NoAction)
  rawLot    RawMaterialLot? @relation(fields: [rawLotId], references: [id], onDelete: SetNull)

  @@unique([shopId, slipNumber])
  @@index([shopId])
  @@index([gateEntryId])
  @@index([status])
  @@map("weighbridge_entries")
}

// ─── Logistics: freight ledger + dispatch ──────────────────────────────────
// A mill runs a running account with each Transporter (Customer row with
// customerType='transporter') — freight charged per trip, paid off later in
// lump sums — the reverse direction of a normal Party's udhar (here the MILL
// owes the transporter, not the other way round), so this is its own simple
// running-balance ledger rather than reusing customer_transactions/totalDue.

model FreightEntry {
  id            String    @id @default(uuid()) @db.Uuid
  shopId        String    @map("shop_id") @db.Uuid
  transporterId String    @map("transporter_id") @db.Uuid // Customer.id, customerType='transporter'
  type          String    @db.VarChar // charge | payment
  amount        Float
  vehicleNumber String?   @map("vehicle_number") @db.VarChar
  gateEntryId   String?   @map("gate_entry_id") @db.Uuid
  paymentMethod String?   @map("payment_method") @db.VarChar
  note          String?   @db.VarChar
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  shop        Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  transporter Customer   @relation(fields: [transporterId], references: [id], onDelete: Cascade)
  gateEntry   GateEntry? @relation(fields: [gateEntryId], references: [id], onDelete: SetNull)

  @@index([shopId])
  @@index([transporterId])
  @@map("freight_entries")
}

// A dispatch is what's actually leaving the mill (product + qty), distinct
// from GateEntry which just logs the truck's physical movement — a gate
// entry has no structured line item, only a free-text materialDescription.
model DispatchEntry {
  id             String    @id @default(uuid()) @db.Uuid
  shopId         String    @map("shop_id") @db.Uuid
  dispatchNumber String    @map("dispatch_number") @db.VarChar
  partyId        String?   @map("party_id") @db.Uuid
  vehicleNumber  String?   @map("vehicle_number") @db.VarChar
  gateEntryId    String?   @map("gate_entry_id") @db.Uuid
  productId      String?   @map("product_id") @db.Uuid
  quantity       Float?
  unit           String?   @db.VarChar
  notes          String?   @db.VarChar
  dispatchedAt   DateTime  @default(now()) @map("dispatched_at") @db.Timestamptz(6)
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  shop      Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  party     Customer?  @relation(fields: [partyId], references: [id], onDelete: NoAction)
  gateEntry GateEntry? @relation(fields: [gateEntryId], references: [id], onDelete: SetNull)
  product   Product?   @relation(fields: [productId], references: [id], onDelete: NoAction)

  @@unique([shopId, dispatchNumber])
  @@index([shopId])
  @@index([partyId])
  @@map("dispatch_entries")
}

// ─── Management: broker commission + machines/maintenance/spare parts ─────
// Same running-ledger shape as FreightEntry, just pointed at Customer rows
// with customerType='broker' — a broker earns commission per deal closed
// through them (the mill owes them), settled later, same direction as
// freight, so it deliberately doesn't reuse customer_transactions/totalDue
// (that model's direction is the customer owing the shop, the opposite way).

model CommissionEntry {
  id            String    @id @default(uuid()) @db.Uuid
  shopId        String    @map("shop_id") @db.Uuid
  brokerId      String    @map("broker_id") @db.Uuid // Customer.id, customerType='broker'
  type          String    @db.VarChar // charge | payment
  amount        Float
  billNumber    String?   @map("bill_number") @db.VarChar
  paymentMethod String?   @map("payment_method") @db.VarChar
  note          String?   @db.VarChar
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  shop   Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  broker Customer @relation(fields: [brokerId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([brokerId])
  @@map("commission_entries")
}

// A mill's physical equipment (huller, polisher, dryer, weighbridge unit…)
// with a maintenance history and the spare parts kept on hand for it.
model Machine {
  id           String    @id @default(uuid()) @db.Uuid
  shopId       String    @map("shop_id") @db.Uuid
  name         String    @db.VarChar
  machineType  String?   @map("machine_type") @db.VarChar
  purchaseDate DateTime? @map("purchase_date") @db.Timestamptz(6)
  cost         Float?
  status       String    @default("working") @db.VarChar // working | under_maintenance | retired
  notes        String?   @db.VarChar
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  shop               Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  maintenanceEntries MaintenanceEntry[]
  spareParts         SparePart[]
  downtimes          MachineDowntime[]

  @@index([shopId])
  @@map("machines")
}

model MaintenanceEntry {
  id           String    @id @default(uuid()) @db.Uuid
  shopId       String    @map("shop_id") @db.Uuid
  machineId    String    @map("machine_id") @db.Uuid
  description  String    @db.VarChar
  cost         Float?
  performedBy  String?   @map("performed_by") @db.VarChar
  serviceDate  DateTime  @default(now()) @map("service_date") @db.Timestamptz(6)
  nextDueDate  DateTime? @map("next_due_date") @db.Timestamptz(6)
  notes        String?   @db.VarChar
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  shop    Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([machineId])
  @@map("maintenance_entries")
}

// One stretch a machine was actually down — distinct from MaintenanceEntry
// (a service log entry that may or may not involve downtime, e.g. a
// scheduled oil change done while the machine kept running). endedAt null
// means still down right now; ending it is what the Availability %
// calculation (v1 of "OEE" — see MachineDowntime consumers) treats as the
// close of one downtime window. Optionally links to the MaintenanceEntry
// that fixed it, so "why was it down" and "what fixed it" stay connected
// without forcing every downtime to go through a repair log.
model MachineDowntime {
  id            String    @id @default(uuid()) @db.Uuid
  shopId        String    @map("shop_id") @db.Uuid
  machineId     String    @map("machine_id") @db.Uuid
  reason        String?   @db.VarChar
  startedAt     DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt       DateTime? @map("ended_at") @db.Timestamptz(6)
  maintenanceEntryId String? @map("maintenance_entry_id") @db.Uuid
  notes         String?   @db.VarChar
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  shop    Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([machineId])
  @@map("machine_downtimes")
}

model SparePart {
  id        String    @id @default(uuid()) @db.Uuid
  shopId    String    @map("shop_id") @db.Uuid
  name      String    @db.VarChar
  machineId String?   @map("machine_id") @db.Uuid // optional — which machine this part is for
  quantity  Float     @default(0)
  minStock  Float?    @map("min_stock")
  unitCost  Float?    @map("unit_cost")
  notes     String?   @db.VarChar
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  shop      Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  machine   Machine?            @relation(fields: [machineId], references: [id], onDelete: SetNull)
  movements SparePartMovement[]

  @@index([shopId])
  @@map("spare_parts")
}

model SparePartMovement {
  id          String    @id @default(uuid()) @db.Uuid
  shopId      String    @map("shop_id") @db.Uuid
  sparePartId String    @map("spare_part_id") @db.Uuid
  type        String    @db.VarChar // in | out
  quantity    Float
  note        String?   @db.VarChar
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  shop      Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  sparePart SparePart @relation(fields: [sparePartId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([sparePartId])
  @@map("spare_part_movements")
}
