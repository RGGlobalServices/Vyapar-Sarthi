// A physical stock-take/audit session — "count every product against what
// the system thinks you have, review the variance, commit once." Distinct
// from the existing per-product AdjustDrawer/adjust endpoints (which stay
// untouched and still work standalone): this is the bulk, session-based
// workflow those don't cover. Deliberately reuses the same simple
// `/products/[id]/adjust`-style stock mutation at commit time rather than a
// new stock-mutation path, so committed variances show up in the same
// StockLog history everything else already reads.
model StockTakeSession {
  id          String    @id @default(uuid()) @db.Uuid
  shopId      String    @map("shop_id") @db.Uuid
  name        String?   @db.VarChar
  status      String    @default("draft") @db.VarChar // draft | completed | cancelled
  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  notes       String?

  shop  Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  items StockTakeItem[]

  @@index([shopId])
  @@map("stock_take_sessions")
}

model StockTakeItem {
  id          String   @id @default(uuid()) @db.Uuid
  sessionId   String   @map("session_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  // Snapshots at session-start time so a variance stays meaningful even if
  // the product is renamed/sold-against mid-count — the same reasoning as
  // every other line-item snapshot in this schema (PurchaseItem, OrderItem).
  productName String   @map("product_name") @db.VarChar
  unit        String?  @db.VarChar
  systemQty   Float    @map("system_qty")
  countedQty  Float?   @map("counted_qty")
  countedAt   DateTime? @map("counted_at") @db.Timestamptz(6)

  session StockTakeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  product Product          @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([productId])
  @@map("stock_take_items")
}

