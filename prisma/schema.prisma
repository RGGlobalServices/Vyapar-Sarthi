// A named, dated sheet grouping many party-payment rows collected in one
// round (see CollectionEntry) — modeled on a distributor's physical daily
// collection ledger. `status` is a bookkeeping seal, not a gate on whether
// money moved: every CollectionEntry posts a real payment (via the same
// helper crm/payments uses) the moment it's saved, draft or not. Finalizing
// just locks the sheet and files it into the searchable history.
model CollectionSheet {
  id          String            @id @default(uuid()) @db.Uuid
  shopId      String            @map("shop_id") @db.Uuid
  name        String            @db.VarChar
  date        DateTime          @db.Date
  status      String            @default("draft") @db.VarChar
  finalizedAt DateTime?         @map("finalized_at") @db.Timestamptz(6)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  entries     CollectionEntry[]
  shop        Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([shopId, status])
  @@index([shopId, date])
  @@map("collection_sheets")
}

// One party row within a CollectionSheet. `customerTransactionId` links back
// to the customer_transactions row this entry's payment created — present
// as soon as the row is saved, used to reverse (edit/delete) via the same
// path a directly-deleted payment already uses (see
// lib/server/customerPayment.ts).
model CollectionEntry {
  id                    String          @id @default(uuid()) @db.Uuid
  sheetId               String          @map("sheet_id") @db.Uuid
  customerId            String          @map("customer_id") @db.Uuid
  amount                Float
  paymentMode           String          @map("payment_mode") @db.VarChar
  note                  String?         @db.VarChar
  customerTransactionId String?         @map("customer_transaction_id") @db.Uuid
  // Same same-day insertion-order tiebreaker purpose as
  // SupplierTransaction.sequence (see that model for why createdAt alone
  // isn't enough — a date-only picker collapses same-day rows to midnight).
  sequence              Int             @default(autoincrement())
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  sheet                 CollectionSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  customer              Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([sheetId])
  @@index([customerId])
  @@map("collection_entries")
}

model SupplierTransaction {
  id          String    @id @default(uuid()) @db.Uuid
  supplierId  String?   @map("supplier_id") @db.Uuid
  type        String?   @db.VarChar
  amount      Float?
  note        String?   @db.VarChar
  billNumber  String?   @map("bill_number") @db.VarChar
  // Only meaningful on 'payment' rows (a standalone payment or the
  // auto-generated part-payment leg of a purchase) — a 'purchase' row isn't
  // itself a payment event, so it stays null. 'Cash' | 'UPI' | 'Card'.
  paymentMethod String? @map("payment_method") @db.VarChar
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  // Monotonic insertion-order tiebreaker. createdAt alone is ambiguous once
  // backdated: the date picker sends a date-only string, which parses to
  // midnight — so every row entered against the same business day collapses
  // to the identical timestamp and Postgres has no defined order among them.
  // Sorting by [createdAt desc, sequence desc] keeps "newest activity on top"
  // reliable even when several same-day rows exist.
  sequence    Int       @default(autoincrement())
  supplier    Supplier? @relation(fields: [supplierId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([supplierId])
  @@map("supplier_transactions")
}

model CalendarEvent {
  id           String   @id @default(uuid()) @db.Uuid
  shopId       String   @map("shop_id") @db.Uuid
  ownerId      String?  @map("owner_id") @db.Uuid
  title        String   @db.VarChar
  description  String?  @db.VarChar
  eventDate    DateTime @map("event_date") @db.Timestamptz(6)
  eventType    String   @default("event") @map("event_type") @db.VarChar
  amount       Float?
  customerName String?  @map("customer_name") @db.VarChar
  status       String   @default("pending") @db.VarChar
  reminderDays Int      @default(1) @map("reminder_days")
  notified     Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([shopId, eventDate])
  @@map("calendar_events")
}

model MaterialReturn {
  id          String       @id @default(uuid()) @db.Uuid
  shopId      String       @map("shop_id") @db.Uuid
  productId   String?      @map("product_id") @db.Uuid
  itemName    String?      @db.VarChar
  quantity    Float
  reason      String       @db.VarChar // e.g. "Damaged", "Wrong Item", "Defective", etc.
  note        String?      @db.VarChar
  amount      Float?
  date        DateTime?    @default(now()) @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  shop        Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product     Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)
  returnItems ReturnItem[]

  @@index([shopId])
  @@index([productId])
  @@map("material_returns")
}

model ProductVariant {
  id           String    @id @default(uuid()) @db.Uuid
  productId    String    @map("product_id") @db.Uuid
  size         String?   @db.VarChar
  unit         String?   @db.VarChar
  barcode      String?   @unique @db.VarChar
  costPrice    Float?    @map("cost_price")
  sellingPrice Float?    @map("selling_price")
  mrp          Float?
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  batches       Batch[]
  purchaseItems PurchaseItem[]

  @@index([productId])
  @@map("product_variants")
}

model Supplier {
  id        String    @id @default(uuid()) @db.Uuid
  shopId    String    @map("shop_id") @db.Uuid
  name      String    @db.VarChar
  contact   String?   @db.VarChar
  mobile    String?   @db.VarChar
  email     String?   @db.VarChar
  address   String?   @db.VarChar
  gst       String?   @db.VarChar
  balance   Float     @default(0)
  creditDays  Int?    @default(0) @map("credit_days")
  creditLimit Float?  @default(0) @map("credit_limit")
  documents Json?     @default("[]")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  shop                 Shop                  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  purchaseInvoices     PurchaseInvoice[]
  purchaseReturns      PurchaseReturn[]
  supplierTransactions SupplierTransaction[]
  rawMaterialLots      RawMaterialLot[]
  orders               Order[]
  gateEntries          GateEntry[]
  weighbridgeEntries   WeighbridgeEntry[]

  @@index([shopId])
  @@map("suppliers")
}

model PurchaseInvoice {
  id            String    @id @default(uuid()) @db.Uuid
  shopId        String    @map("shop_id") @db.Uuid
  supplierId    String    @map("supplier_id") @db.Uuid
  invoiceNumber String?   @map("invoice_number") @db.VarChar
  date          DateTime? @default(now()) @db.Timestamptz(6)
  totalCost     Float?    @map("total_cost")
  gst           Float?
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  shop            Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  supplier        Supplier         @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  purchaseItems   PurchaseItem[]
  purchaseReturns PurchaseReturn[]

  @@index([shopId])
  @@index([supplierId])
  @@map("purchase_invoices")
}

model PurchaseItem {
  id                String  @id @default(uuid()) @db.Uuid
  purchaseInvoiceId String  @map("purchase_invoice_id") @db.Uuid
  productId         String  @map("product_id") @db.Uuid
  variantId         String? @map("variant_id") @db.Uuid
  // Composite "Colour / Size" (or bare size) key into Product.variants[] JSON —
  // NOT the same thing as variantId above, which points at the unused relational
  // ProductVariant table. Lets an edit/delete look back at exactly which
  // variants[] row this line's quantity was added to, so it can be reversed.
  variantKey        String? @map("variant_key") @db.VarChar
  quantity          Float
  cost              Float
  gst               Float?
  // Locked in at the moment this line was purchased — never rewritten after
  // insert (same as `cost` above), so a later change to the product's MRP or
  // default purchase_discount_percent never alters what this line actually
  // paid. Null when this line was entered in Manual cost mode.
  mrp               Float?
  discountPercent   Float?  @map("discount_percent")
  // The exact Batch row this purchase line created — set at insert time (the
  // id is pre-generated in JS so both rows can reference each other despite
  // being created via sibling createMany calls in the same transaction).
  // Nullable because historical rows predate this link.
  batchId           String? @map("batch_id") @db.Uuid

  purchaseInvoice PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  batch           Batch?          @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([purchaseInvoiceId])
  @@index([productId])
  @@map("purchase_items")
}

/** Records which Batch(es) a Sale line's quantity was actually drawn from,
 *  and the batch's real cost at that moment — a join table rather than a
 *  single FK on SaleItem because a FIFO walk can split one cart line across
 *  two batches with two different costs (e.g. 5 units from a ₹100 lot + 3
 *  from a ₹120 lot on one bill line). This is what makes real per-batch
 *  profit possible instead of always using Product.costPrice. */
model SaleItemBatch {
  id         String    @id @default(uuid()) @db.Uuid
  saleItemId String    @map("sale_item_id") @db.Uuid
  batchId    String    @map("batch_id") @db.Uuid
  quantity   Float
  // Batch.costPrice captured at the moment of sale — stays correct even if
  // the batch's own cost is edited/corrected afterward.
  costAtSale Float     @map("cost_at_sale")
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  saleItem SaleItem @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  batch    Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([saleItemId])
  @@index([batchId])
  @@map("sale_item_batches")
}

/** Goods sent back to a supplier from a specific purchase (damaged, wrong
 *  item, excess stock, …) — a debit note. Deliberately its own model rather
 *  than reusing MaterialReturn/ReturnItem: those are the SALES side (a
 *  customer's refund — stockRestored: true, money flows OUT via
 *  refundAmount) with no link to a purchase or supplier at all. A purchase
 *  return is the opposite direction (stock DECREASES, money owed to the
 *  supplier decreases) and always belongs to one PurchaseInvoice. The
 *  original PurchaseInvoice/PurchaseItem rows are never edited — this is an
 *  additive record; "net payable" is computed as totalCost minus the sum of
 *  its returns. */
model PurchaseReturn {
  id                String    @id @default(uuid()) @db.Uuid
  shopId            String    @map("shop_id") @db.Uuid
  supplierId        String    @map("supplier_id") @db.Uuid
  purchaseInvoiceId String    @map("purchase_invoice_id") @db.Uuid
  returnNumber      String?   @map("return_number") @db.VarChar
  date              DateTime? @default(now()) @db.Timestamptz(6)
  totalAmount       Float     @map("total_amount")
  note              String?   @db.VarChar
  createdAt         DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  shop            Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)
  supplier        Supplier             @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  purchaseInvoice PurchaseInvoice      @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  items           PurchaseReturnItem[]

  @@index([shopId])
  @@index([purchaseInvoiceId])
  @@index([supplierId])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id         String  @id @default(uuid()) @db.Uuid
  returnId   String  @map("return_id") @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  // Editable snapshot at return time — same idea as BillLine.name in
  // AddBillModal.tsx, so a shopkeeper can clarify/correct it on the document
  // without that touching the actual Product record.
  name       String  @db.VarChar
  variantKey String? @map("variant_key") @db.VarChar
  quantity   Float
  rate       Float
  amount     Float

  purchaseReturn PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([returnId])
  @@map("purchase_return_items")
}

model Batch {
  id          String    @id @default(uuid()) @db.Uuid
  shopId      String    @map("shop_id") @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  variantId   String?   @map("variant_id") @db.Uuid
  batchNumber String?   @map("batch_number") @db.VarChar
  mfgDate     DateTime? @map("mfg_date") @db.Timestamptz(6)
  expiryDate  DateTime? @map("expiry_date") @db.Timestamptz(6)
  // Current available stock in this lot — decremented in place as sales draw
  // from it. `initialQuantity` below preserves what it started at, since this
  // field alone can't answer "how much of this lot did we ever have" once
  // sales start eating into it.
  quantity    Float     @default(0)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  // --- Real per-lot commercial data (added for batch-wise costing/profit) ---
  initialQuantity Float?    @map("initial_quantity")
  costPrice       Float?    @map("cost_price")
  sellingPrice    Float?    @map("selling_price")
  purchaseDate    DateTime? @map("purchase_date") @db.Timestamptz(6)
  // Batch-specific scan code (e.g. "PROD101-B1") — additive alongside
  // Product.barcode/ProductVariant.barcode, never replacing them. Nullable
  // because historical rows predate this column.
  barcode         String?   @unique @db.VarChar

  shop          Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  purchaseItems PurchaseItem[]
  saleItemBatches SaleItemBatch[]

  @@index([shopId])
  @@index([productId])
  @@map("batches")
}

model StockMovement {
  id          String    @id @default(uuid()) @db.Uuid
  shopId      String    @map("shop_id") @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  variantId   String?   @map("variant_id") @db.Uuid
  warehouseId String?   @map("warehouse_id") @db.Uuid
  type        String    @db.VarChar // purchase, sale, return, adjustment, transfer
  quantity    Float
  referenceId String?   @map("reference_id") @db.Uuid
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([shopId])
  @@index([productId])
  @@map("stock_movements")
}

// Platform-wide "industry vertical" master data (Kirana, Garment, Pharmacy,
// Bhagar/Rice Mill, …) — what a shop picks in Profile's "Change Business
// Category" wizard. NOT the same thing as Category below, which is a
// per-shop, free-text PRODUCT category ("Rice", "Cold Drinks") a shopkeeper
// types in while adding products. This table has no shopId — it's global,
// admin-managed master data shared by every shop on the platform.
//
// mappedBusinessType, when set, is the id of an existing BusinessType from
// lib/businessConfig.ts (e.g. 'millprocessing') — picking this category can
// set the shop's real businessType to that value, which is what actually
// drives product-field gating (hasSizes/hasBatch/hasExpiry/etc). Left null
// for categories with no equivalent in the current engine yet (e.g. Salon &
// Spa, Accounting & CA) — those still save as the shop's chosen category,
// just without changing which product fields show.
model IndustryCategory {
  id                 String    @id @default(uuid()) @db.Uuid
  name               String    @db.VarChar
  nameHi             String?   @map("name_hi") @db.VarChar
  nameMr             String?   @map("name_mr") @db.VarChar
  emoji              String?   @db.VarChar
  // 'retail' | 'wholesale' | 'distributor' | 'service' | 'manufacturing' | 'other'
  businessTypeMeta   String    @map("business_type_meta") @db.VarChar
  mappedBusinessType String?   @map("mapped_business_type") @db.VarChar
  active             Boolean   @default(true)
  sortOrder          Int       @default(0) @map("sort_order")
  createdAt          DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([name])
  @@index([businessTypeMeta])
  @@index([active])
  @@map("industry_categories")
}

model Category {
