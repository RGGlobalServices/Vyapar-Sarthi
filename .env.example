# ── Vyapar Sarthi — App (UI + API) environment ──
# The app serves both the dashboard and the API (/api/v1/*) from one Next.js
# server. The landing page is a SEPARATE repository/deployment.
# Copy to .env.local for local dev; set these in your host's env for production.

# === Database (Supabase / PostgreSQL) ===
# On constrained/managed hosting (e.g. Hostinger Node) use the Supabase POOLER
# (port 6543) with a low connection_limit. This avoids the Prisma engine panic
# "PANIC: timer has gone away" that occurs when too many connections / cold-start
# races hit the query engine on a throttled container.
#   postgresql://postgres.<ref>:<pwd>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=20&connect_timeout=15
DATABASE_URL="postgresql://user:password@host:6543/database?pgbouncer=true&connection_limit=1&pool_timeout=20&connect_timeout=15"

# === Port ===
PORT=3000

# === Auth ===
SECRET_KEY="your-jwt-secret"
ADMIN_SECRET_KEY="your-admin-secret"

# === URLs ===
# App serves its own API at the same origin → relative is fine locally & in prod.
NEXT_PUBLIC_API_URL="/api/v1"
NEXT_PUBLIC_FRONTEND_URL="http://localhost:3000"
NEXT_PUBLIC_LANDING_URL="http://localhost:3001"
# Server-side (CORS allow-list, links, emails)
FRONTEND_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
LANDING_URL="http://localhost:3001"

# === AI assistant ===
# OpenRouter powers the AI assistant — https://openrouter.ai/keys
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="nvidia/nemotron-3-nano-30b-a3b:free"

# === OpenAI (Import scanning — PRIMARY, faster & production-grade) ===
# Get your key at: https://platform.openai.com/api-keys
# gpt-4o-mini is the default: fast, cheap, great for printed invoices.
# Use gpt-4o for better accuracy on complex/handwritten bills.
OPENAI_API_KEY=
# IMPORT_OPENAI_MODEL=gpt-4o-mini

# === Gemini (Import scanning — SECONDARY / fallback, free) ===
# Used automatically when OpenAI key is not set or quota is exhausted.
# Get your key at: https://aistudio.google.com/app/apikey
# Add up to 4 keys (from different Google accounts) to multiply your free quota.
GEMINI_API_KEY=""
GEMINI_API_KEY_2=""
GEMINI_API_KEY_3=""
GEMINI_API_KEY_4=""

# Model chain for Gemini fallback (comma-separated, tried in order on quota):
# IMPORT_GEMINI_MODELS="gemini-2.5-flash,gemini-2.5-flash-lite"

NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# === SMTP (optional) ===
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SUPPORT_EMAIL=""

# === PayU (subscriptions, optional) ===
PAYU_KEY=""
PAYU_SALT=""

# === Subscription cron ===
# Guards /api/v1/cron/process-subscriptions. Set a long random value and run a
# daily GET with header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""

# Signs the one-click renewal links sent by WhatsApp/email. REQUIRED for those links:
# generate a long random value (32+ chars). No default — without it the links are disabled
# (reminders fall back to the in-app payment page). Must NOT be the same as CRON_SECRET.
RENEWAL_LINK_SECRET=""

# TEST ONLY: lets payments/activate-plan activate a plan without payment. Ignored in
# production (NODE_ENV=production can never enable it). Leave unset/false everywhere real.
ALLOW_TEST_PLAN_ACTIVATION=""

# === Supabase storage (optional) ===
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Mill Billing (Bada Udyog "mill_v2") internal platform kill-switch. OFF by default: while it is not "true", the Bada
# Udyog billing screen shows an "unavailable" state and no mill_v2 bill can be created (there is NO fallback to legacy
# billing). Mill Billing itself is part of the Bada Udyog package; this is a deployment safety flag, not a customer setting.
MILL_V2_ENABLED=false
